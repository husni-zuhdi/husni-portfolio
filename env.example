SVC_ENDPOINT="127.0.0.1"
SVC_PORT="8080"
LOG_LEVEL="INFO"
ENVIRONMENT="Development"
DATA_SOURCE=sqlite
DATABASE_URL="sqlite:husni-portfolio.db"
TURSO_AUTH_TOKEN="replace-with-your-turso-token"
JWT_SECRET="replace-with-a-private-random-secret"
SECRETS_BUCKET=""
SECRETS_OBJECT=""
CACHE_TYPE="InMemory"
CACHE_TTL=3600
RATE_LIMIT_BURST_SIZE=10
RATE_LIMIT_REPLENISH_PERIOD_SECOND=60
